<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="brand">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Error <%= error && error.code ? error.code : '' %> — Vela</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap">
<style>:root{color-scheme:dark}*{box-sizing:border-box;margin:0}body{font:400 15px/1.6 Sora,system-ui,sans-serif;background:var(--bg,#0e1013);color:var(--tx,#e9ebef);min-height:100vh;display:grid;place-items:center;padding:24px}a{color:inherit}.box{max-width:480px;text-align:center;border:1px solid var(--line,#262b34);border-radius:18px;background:var(--bg2,#14171c);padding:48px 36px}.code{font-size:4rem;font-weight:700;color:var(--acc,#a9b9d8)}.msg{color:var(--mut,#98a0ae);margin:10px 0 26px}.btn{display:inline-block;padding:12px 26px;border-radius:10px;background:linear-gradient(180deg,var(--btn-hi,#f2f4f8),var(--btn-lo,#b9c0cc));color:var(--color-primary-content,#0e1013);font-weight:700;text-decoration:none}</style>
<link rel="stylesheet" href="/css/brand-theme.css">
</head>
<body>
<div class="box">
<div class="code"><%= error && error.code ? error.code : 'Error' %></div>
<div class="msg"><%= error && error.message ? error.message : 'Something went wrong.' %></div>
<a class="btn" href="/">Go home</a>
</div>
</body>
</html>
