<%- include('partials/head') %>
<%- include('partials/sidebar') %>
<div class="ph"><h1><%= title %></h1><p><%= typeof page !== 'undefined' ? page : '' %> — toggles save via the existing API.</p></div>
<div class="card"><h2>Commands</h2>
<table class="tbl"><tr><th>Command</th><th>Description</th><th>Enabled</th></tr>
<% (typeof commands !== 'undefined' ? commands : []).forEach(c => { %>
<tr><td>/<%= c.name %></td><td><%= c.description %></td><td><span class="pill<%= c.enabled ? ' on' : '' %>"><%= c.enabled ? 'on' : 'off' %></span></td></tr>
<% }) %>
</table></div>
<div class="card"><div class="row"><div><span class="lb">Manage in new dashboard</span><small>Commands tab</small></div><a class="btn p" href="/dashboard#commands">Open</a></div></div>
<%- include('partials/foot') %>
