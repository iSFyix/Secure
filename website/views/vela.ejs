$("#ceCancel").onclick=()=>{if(ceCmd){S["aliases_"+ceCmd]=ceAliasesOrig.join(", ");chk()}if(ceInvCmd){S["aliases_"+ceInvCmd]=ceInvAliasesOrig.join(", ");chk()}if(window.__ceSecRevert){S[window.__ceSecRevert.key]=window.__ceSecRevert.prev;window.__ceSecRevert=null;chk();updateSecUI();}window.__ceSecReturn=false;closeCmdEdit()};
