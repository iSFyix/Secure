    document.getElementById("tkStats").innerHTML=list.length?`<table class="tkt"><tr><th>#</th><th>Staff</th><th>Received</th><th>Finished</th><th>Points</th></tr>${list.map((s,i)=>`<tr><td>${i+1}</td><td>${E(s.userTag||s.userId)}</td><td>${s.received}</td><td>${s.finished}</td><td><b>${s.points}</b></td></tr>`).join("")}</table><p class="empty" style="padding:12px 0 6px">Points = received × 1 + finished × 2</p>`:`<p class="empty">No ticket activity yet.</p>`;
  }).catch(()=>{document.getElementById("tkStats").innerHTML=`<p class="empty">Could not load stats.</p>`});
}
