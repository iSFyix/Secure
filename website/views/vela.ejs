let ceCmd=null;
let ceAliasesArr=[],ceAliasesOrig=[];
let ceInvCmd=null,ceInvAliasesArr=[],ceInvAliasesOrig=[];
const ceParseAliases=s=>String(s||"").split(",").map(a=>a.trim().toLowerCase().replace(/^[/!]+/,"")).filter((a,i,arr)=>a&&arr.indexOf(a)===i);
function ceRenderAliases(){const host=$("#ceChips");host.innerHTML=ceAliasesArr.length?ceAliasesArr.map(a=>`<span class="chip">${E(a)}<button type="button" class="chipx" data-chipx="${E(a)}" aria-label="Remove alias ${E(a)}">×</button></span>`).join(""):`<span class="chip-empty">No aliases yet.</span>`}
function ceRenderInvAliases(){const host=$("#ceInvChips");host.innerHTML=ceInvAliasesArr.length?ceInvAliasesArr.map(a=>`<span class="chip">${E(a)}<button type="button" class="chipx" data-chipx="${E(a)}" aria-label="Remove alias ${E(a)}">×</button></span>`).join(""):`<span class="chip-empty">No aliases yet.</span>`}
function ceWriteAliases(){if(ceCmd){S["aliases_"+ceCmd]=ceAliasesArr.join(", ");chk()}}
