$("#ceSave").onclick=async()=>{if(!ceCmd)return;const n=ceCmd;S["cooldown_"+n]=Math.max(0,Math.round(+$("#ceCooldown").value||0));S["aliases_"+n]=ceAliasesArr.join(", ");if(ceInvCmd)S["aliases_"+ceInvCmd]=ceInvAliasesArr.join(", ");S["allowroles_"+n]=[...document.querySelectorAll("#ddAllowRole input:checked")].map(i=>i.value);S["denyroles_"+n]=[...document.querySelectorAll("#ddDenyRole input:checked")].map(i=>i.value);S["allowchats_"+n]=[...document.querySelectorAll("#ddAllowCh input:checked")].map(i=>i.value);S["denychats_"+n]=[...document.querySelectorAll("#ddDenyCh input:checked")].map(i=>i.value);chk();closeCmdEdit();if(window.__ceSecReturn){window.__ceSecReturn=false;window.__ceSecRevert=null;updateSecUI();}else go("commands");await saveState()};
/* Ctrl+K palette: searches settings + commands, max 8 grouped by section */
const pal=$("#pal"),pin=$("#pin"),pl=$("#pl");let palIdx=0,palItems=[];
function buildIndex(){const out=[];Object.keys(P).forEach(k=>{const p=P[k];(p.g||[]).forEach(g=>g[1].forEach(f=>{if(f[0]==="pv"||f[0]==="logrow"||f[0]==="cmd"||f[0]==="btn")return;out.push({sec:p.t,mod:k,label:f[2],key:f[1]})}))});return out}
const IDX=buildIndex();
function openPal(){pal.classList.add("o");pin.value="";renderPal("");setTimeout(()=>pin.focus(),30)}
function closePal(){pal.classList.remove("o")}
function renderPal(q){q=q.trim().toLowerCase();const r=(q?IDX.filter(i=>(i.label+" "+i.sec).toLowerCase().includes(q)):IDX.slice(0,8)).slice(0,8);palItems=r;palIdx=0;pl.innerHTML=r.length?r.map((i,n)=>`<button type="button" role="option" data-n="${n}" aria-selected="${n===0}"><span>${E(i.label)}</span><small>${E(i.sec)}</small></button>`).join(""):`<div style="padding:16px;color:var(--mut);font-size:.86rem">No matches. Try “welcome”, “log” or “ban”.</div>`}
pin.addEventListener("input",()=>renderPal(pin.value));
pl.addEventListener("click",e=>{const b=e.target.closest("button[data-n]");if(b)jump(+b.dataset.n)});
function jump(n){const it=palItems[n];if(!it)return;closePal();go(it.mod);setTimeout(()=>{const el=document.getElementById(it.key)||document.querySelector(`[data-k="${it.key}"]`);if(el){el.scrollIntoView({block:"center"});el.focus&&el.focus({preventScroll:true});const ad=el.closest(".adv");if(ad){ad.classList.add("open");ad.querySelector("button").setAttribute("aria-expanded","true")}}},60)}
function renderPalActive(){pl.querySelectorAll("button").forEach((b,n)=>b.setAttribute("aria-selected",n===palIdx))}
$("#kp").onclick=openPal;pal.addEventListener("click",e=>{if(e.target===pal)closePal()});
addEventListener("keydown",e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="k"){e.preventDefault();pal.classList.contains("o")?closePal():openPal()}if(pal.classList.contains("o")&&palItems.length){if(e.key==="ArrowDown"){e.preventDefault();palIdx=(palIdx+1)%palItems.length;renderPalActive()}if(e.key==="ArrowUp"){e.preventDefault();palIdx=(palIdx-1+palItems.length)%palItems.length;renderPalActive()}if(e.key==="Enter"){e.preventDefault();jump(palIdx)}}});
const side=$("#side"),sc=$("#sc"),tg=o=>{side.classList.toggle("o",o);sc.classList.toggle("o",o)};
$("#mn").onclick=()=>tg(1);sc.onclick=()=>tg(0);addEventListener("keydown",e=>{if(e.key=="Escape")tg(0)});
const collapseBtn=$("#collapseBtn");if(collapseBtn)collapseBtn.onclick=()=>{const app=document.querySelector(".app");const closed=app.classList.toggle("closed");collapseBtn.setAttribute("aria-expanded",!closed);};
