    const r=await window.__velaFetch("/api/vela/save",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({state:st})});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.success)throw new Error((d&&d.errors&&d.errors[0])||(d&&d.error)||"save failed");
    S=st;saved=cl(S);chk();
    AUD.unshift({t:new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"}),c:[...new Set(c)]});
    toast("Changes saved.");
    if(cur==="applications")go(cur);
    return true;
  }catch(err){toast("Not saved: "+(err.message||err),true);return false}
}
function welcomeTestConfig(){
  const chs=window.__VELA_CHANNELS||[];
  const raw=String(S.wCh||"").trim();
  let id=chs.some(c=>String(c.id)===raw)?raw:"";
  if(!id){
    const nm=raw.replace(/^#/,"").toLowerCase();
    const f=chs.find(c=>String(c.name||"").toLowerCase()===nm);
    id=f?f.id:"";
  }
  if(!id){toast("Pick a welcome channel first.",true);return null}
  const px=(v,f)=>Math.round(Number(v||0)/100*f);
  const cl=(v,a,b)=>Math.min(b,Math.max(a,v));
  return {
    enabled:true,channelId:id,imageChannelId:id,
    messageType:"card",imageMode:"with",textEnabled:!!S.wOn,
    message:String(S.wMsg||""),textMessage:String(S.wMsg||""),
    card:{enabled:true,background:String(S.wImg||""),
      username:{text:"{username}",x:cl(px(S.wNx,800),0,800),y:cl(px(S.wNy,350),0,350),fontSize:cl(px(S.wNs,800),8,120),color:"#ffffff",align:"center",show:S.wShowN!==false},
      avatar:{x:cl(px(S.wAx,800),0,800),y:cl(px(S.wAy,350),0,350),size:cl(px(S.wAs,800),20,400),shape:"circle",borderWidth:4,borderColor:"#3b82f6",show:S.wShowA!==false}},
    dm:{enabled:!!S.wDm,message:String(S.wMsg||"")}
  };
}
async function sendWelcomeTest(){
  const cfg=welcomeTestConfig();if(!cfg)return;
  toast("Sending test card…");
  try{
    const r=await window.__velaFetch("/api/welcome/test",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(cfg)});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.success)throw new Error((d&&d.error)||"test failed");
    toast(d.message||"Test card sent.");
  }catch(e){toast("Test failed: "+(e.message||e),true)}
}
