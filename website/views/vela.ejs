    const item={id:tkCustEdit!==null&&S.tkCustomBtns[tkCustEdit]?S.tkCustomBtns[tkCustEdit].id:("c"+Date.now().toString(36)+Math.floor(Math.random()*46656).toString(36)),label,emoji:document.getElementById("tkCustEmoji").value.trim().slice(0,20),enabled:tkCustEdit!==null&&S.tkCustomBtns[tkCustEdit]?S.tkCustomBtns[tkCustEdit].enabled!==false:true,kind:"button",type:"link",commands:[],url,timeoutMinutes:10,name:""};
