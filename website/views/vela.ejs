function cardHTML(title,fields,mod){
  const mi=(mod&&P[mod]&&P[mod].i)||"gear", md=(mod&&P[mod]&&P[mod].d)||"";
  const fm=fields.find(f=>f[0]==="sw");
  const rest=fields.filter(f=>f!==fm);
  const btns=rest.filter(f=>f[0]==="btn"), rest2=rest.filter(f=>f[0]!=="btn");
  const open=!fm||!!S[fm[1]];
  const icon=`<span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true">${I[mi]||""}</svg></span>`;
  const head=fm
    ?`<div class="mod-h">${icon}<div style="flex:1;min-width:0"><b id="m-${fm[1]}">${title}</b><small style="color:var(--mut)">${md}</small></div><div class="sw-w"><span class="sw-st" data-st="${fm[1]}">${open?"Enabled":"Disabled"}</span><button class="sw" role="switch" aria-labelledby="m-${fm[1]}" aria-checked="${open}" data-k="${fm[1]}"></button></div></div>`
    :`<div class="mod-h">${icon}<div style="flex:1;min-width:0"><b>${title}</b>${md?`<small style="color:var(--mut)">${md}</small>`:""}</div></div>`;
