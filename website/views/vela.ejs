<% const VLOGO = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='30' fill='%23000'/%3E%3Ccircle cx='32' cy='32' r='29' fill='none' stroke='%23c9ccd4' stroke-width='2'/%3E%3Ctext x='32' y='44' font-size='30' text-anchor='middle' fill='%23f2f2f5' font-family='sans-serif' font-weight='bold'%3EV%3C/text%3E%3C/svg%3E"; %>
<!DOCTYPE html>
<html lang="en" dir="ltr" data-theme="brand">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dashboard — Vela</title>
<meta name="robots" content="noindex">
<link rel="icon" href="<%= VLOGO %>">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap">
<style>
:root{--bg:#0e1013;--bg2:#14171c;--bg3:#1a1e25;--line:#262b34;--tx:#e9ebef;--mut:#98a0ae;--acc:#a9b9d8;--glow:rgba(169,185,216,.14);--ok:#9bd0b0;color-scheme:dark}
:root[data-theme=light]{--bg:#f3f4f6;--bg2:#fff;--bg3:#eceef2;--line:#d8dce3;--tx:#12151a;--mut:#5b6472;--acc:#4a5f8c;--glow:rgba(74,95,140,.12);--ok:#2f7a4f;color-scheme:light}
@media(prefers-color-scheme:light){:root:not([data-theme=dark]){--bg:#f3f4f6;--bg2:#fff;--bg3:#eceef2;--line:#d8dce3;--tx:#12151a;--mut:#5b6472;--acc:#4a5f8c;--glow:rgba(74,95,140,.12);--ok:#2f7a4f;color-scheme:light}}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{font:400 15px/1.55 Sora,system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif;background:var(--bg);color:var(--tx)}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px;border-radius:6px}
/* Professional themed scrollbars instead of the plain-white native bar */
*{scrollbar-width:thin;scrollbar-color:var(--line) transparent}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--acc),var(--line));border-radius:99px;border:2px solid var(--bg)}
::-webkit-scrollbar-thumb:hover{background:var(--acc)}
.side::-webkit-scrollbar-thumb{border-color:var(--bg2)}
.pal-list::-webkit-scrollbar-thumb,.dd-list::-webkit-scrollbar-thumb{border-color:var(--bg2)}
/* Collapsible sidebar without any visible scrollbar */
.app{transition:grid-template-columns .25s ease}
.side{min-width:0;scrollbar-width:none;-ms-overflow-style:none;transition:opacity .2s,visibility .25s,padding .25s}
.side::-webkit-scrollbar{display:none;width:0;height:0}
.dsk{display:inline-flex}
@media(min-width:861px){
.app.closed{grid-template-columns:0 1fr}
.app.closed .side{padding-left:0;padding-right:0;border-right:0;overflow:hidden;opacity:0;visibility:hidden;transition:opacity .2s,visibility .25s,padding .25s}
.app.closed .bar{left:0}
}
@media(max-width:860px){.dsk{display:none}}
h1{font-size:1.5rem;letter-spacing:-.02em;font-weight:600}h2{font-size:1rem;font-weight:600}
.app{display:grid;grid-template-columns:250px 1fr;height:100%}
.side{background:var(--bg2);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:16px 12px;gap:4px;overflow-y:auto}
.brand{display:flex;gap:10px;align-items:center;font-weight:700;padding:4px 8px 14px}
.brand img{width:30px;height:30px;border-radius:50%}
.srv{display:flex;gap:10px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--bg);margin-bottom:10px;font-size:.85rem;width:100%;color:var(--tx);font-family:inherit;cursor:pointer}
.srv b{width:28px;height:28px;border-radius:8px;background:var(--bg3);display:grid;place-items:center;font-size:.75rem}
.srv span{flex:1;text-align:left}
.srv img{width:28px;height:28px;border-radius:8px}
.nv{all:unset;box-sizing:border-box;display:flex;gap:10px;align-items:center;padding:9px 10px;border-radius:9px;color:var(--mut);font-size:.88rem;cursor:pointer;transition:background .15s,color .15s}
.nv:hover{background:var(--bg3);color:var(--tx)}
.nv[aria-current=page]{background:var(--bg3);color:var(--tx);box-shadow:inset 2px 0 var(--acc)}
.nv svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}
.grow{flex:1}
.main{display:flex;flex-direction:column;min-width:0;height:100%;overflow:hidden}
.top{display:flex;align-items:center;gap:12px;padding:12px 24px;border-bottom:1px solid var(--line);background:var(--bg);min-height:60px}
.top .grow{color:var(--mut);font-size:.85rem}
.menu{display:none}
.usr{display:flex;gap:8px;align-items:center;font-size:.85rem}
.usr i{width:28px;height:28px;border-radius:50%;background:var(--bg3);border:1px solid var(--line);display:grid;place-items:center;font-style:normal;font-size:.7rem}
.usr img{width:28px;height:28px;border-radius:50%}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:9px 16px;border-radius:9px;font:600 .85rem Sora,sans-serif;border:1px solid var(--line);background:var(--bg2);color:var(--tx);cursor:pointer;transition:border-color .15s,transform .15s}
.btn:hover{border-color:var(--acc)}.btn:active{transform:translateY(1px)}
.btn.p{background:linear-gradient(180deg,var(--btn-hi,#f2f4f8),var(--btn-lo,#b9c0cc));color:var(--color-primary-content,#0e1013);border-color:transparent}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.body{flex:1;overflow-y:auto;padding:28px 24px 100px}
.wrap{max-width:860px;margin:0 auto}
.ph{margin-bottom:22px}.ph p{color:var(--mut);margin-top:4px}
.banner{border:1px solid var(--line);background:var(--bg2);border-radius:10px;padding:10px 14px;font-size:.82rem;color:var(--mut);margin-bottom:20px}
.card{border:1px solid var(--line);border-radius:14px;background:var(--bg2);padding:6px 22px;margin-bottom:16px}
.card>h2{padding:16px 0 4px}
.row{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}
.row:last-child{border:0}
.row label,.row .lb{display:block;font-weight:500;font-size:.92rem}
.row small{display:block;color:var(--mut);font-size:.8rem;margin-top:2px}
.sw{width:46px;height:26px;min-width:44px;min-height:26px;border-radius:99px;background:var(--line);border:0;position:relative;cursor:pointer;flex:none;transition:background .2s;padding:0;font-family:inherit}
.sw:after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:var(--mut);transition:transform .2s,background .2s}
.sw[aria-checked=true]{background:var(--acc)}.sw[aria-checked=true]:after{transform:translateX(20px);background:var(--bg)}
.sw[aria-disabled=true]{opacity:.6;cursor:wait}
.sw-w{display:flex;align-items:center;gap:10px;flex:none}
.sw-st{font-size:.78rem;color:var(--mut);min-width:64px;text-align:end}
[dir=rtl] .sw-st{text-align:start}
/* Guide: progressive disclosure (grid animation, no height anim) + health + palette */
.adv{border-top:1px dashed var(--line);margin-top:4px}
.adv>button{all:unset;box-sizing:border-box;display:flex;width:100%;justify-content:space-between;align-items:center;padding:12px 0;cursor:pointer;font-size:.85rem;color:var(--mut);min-height:44px}
.adv>button:hover{color:var(--tx)}
.adv-body{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .3s cubic-bezier(.4,0,.2,1),opacity .25s ease}
.adv.open .adv-body{grid-template-rows:1fr;opacity:1}
.adv-body>div{overflow:hidden;min-height:0}
/* Guide: module headers with master switch; body opens with animation on enable */
.mod-h{display:flex;align-items:center;gap:12px;padding:14px 0}
.mod-h .ic{width:34px;height:34px;flex:none;border-radius:9px;background:var(--bg3);border:1px solid var(--line);display:grid;place-items:center;color:var(--acc)}
.mod-h .ic svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.mod-h b{display:block;font-size:.92rem}
.mod-h small{display:block;color:var(--mut);font-size:.78rem;margin-top:2px}
.mod-b{display:grid;grid-template-rows:0fr;opacity:0;transition:grid-template-rows .3s cubic-bezier(.4,0,.2,1),opacity .25s ease}
.card.open .mod-b{grid-template-rows:1fr;opacity:1}
.mod-b>div{overflow:hidden;min-height:0}
.health{border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:.82rem;color:var(--mut);margin:0 0 12px;background:var(--bg)}
.pal{position:fixed;inset:0;z-index:80;display:none;place-items:start center;padding:12vh 16px 16px;background:rgba(0,0,0,.5)}
.pal.o{display:grid}
.pal-box{width:min(560px,100%);background:var(--bg2);border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.4)}
.pal-box input{width:100%;padding:14px 16px;background:transparent;border:0;color:var(--tx);font:inherit;font-size:.95rem}
.pal-list{max-height:320px;overflow:auto;padding:6px}
.pal-list button{all:unset;box-sizing:border-box;display:flex;width:100%;justify-content:space-between;gap:12px;padding:10px 12px;border-radius:8px;cursor:pointer;font-size:.86rem;min-height:44px;align-items:center}
.pal-list button:hover,.pal-list button[aria-selected=true]{background:var(--bg3)}
.pal-list small{color:var(--mut)}
.in,.card textarea,.card select{width:min(280px,100%);padding:9px 12px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--tx);font:inherit;font-size:.88rem}
.card textarea{width:100%;resize:vertical;min-height:84px}
.stack{display:block}.stack .in,.stack textarea{margin-top:8px;width:100%}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:16px}
.stat{border:1px solid var(--line);border-radius:14px;background:var(--bg2);padding:18px}
.stat em{font-style:normal;color:var(--mut);font-size:.8rem}.stat b{display:block;font-size:1.6rem;margin-top:4px;color:var(--mut)}
.empty{padding:28px 0;color:var(--mut);text-align:center;font-size:.9rem}
.qa{display:flex;flex-wrap:wrap;gap:10px;padding:14px 0 18px}
.loggrid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:14px 0 18px}
.logsq{border:1px solid var(--line);border-radius:12px;background:var(--bg);padding:14px;display:flex;flex-direction:column;gap:10px;aspect-ratio:1/1;min-width:0;min-height:0;overflow:hidden}
.logsq:hover{border-color:var(--acc)}
.logsq .lh{display:flex;align-items:center;gap:8px}
.logsq .dot{width:12px;height:12px;border-radius:4px;flex:none;border:1px solid var(--line)}
.logsq .lb{font-weight:600;font-size:.86rem;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.logsq select{width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--line);background:var(--bg2);color:var(--tx);font:inherit;font-size:.82rem;cursor:pointer}
.logsq .lf{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto}
.logsq .lc{display:flex;align-items:center;gap:6px;color:var(--mut);font-size:.75rem}
.logsq input[type=color]{width:30px;height:24px;padding:0;border:1px solid var(--line);border-radius:6px;background:var(--bg2);cursor:pointer}
.logsq input[type=color]::-webkit-color-swatch-wrapper{padding:2px}
.logsq input[type=color]::-webkit-color-swatch{border:0;border-radius:4px}
/* Logging: smart filter tabs + event cards + Manage modal */
.logtabs{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 14px;scrollbar-width:thin}
.logtab{all:unset;box-sizing:border-box;display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:10px;border:1px solid var(--line);background:var(--bg2);color:var(--mut);font-size:.83rem;white-space:nowrap;cursor:pointer;min-height:40px}
.logtab:hover{color:var(--tx);border-color:var(--acc)}
.logtab[aria-pressed=true]{background:var(--bg3);color:var(--tx);border-color:var(--acc)}
.logtab svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.logtab .cnt{font-size:.75rem;color:var(--mut);font-variant-numeric:tabular-nums}
.logtab[aria-pressed=true] .cnt{color:var(--acc)}
.logcards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding-bottom:18px}
.logcard{border:1px solid var(--line);border-radius:12px;background:var(--bg2);padding:16px;display:flex;flex-direction:column;gap:8px;min-width:0}
.logcard:hover{border-color:var(--acc)}
.logcard[hidden]{display:none}
.logcard .lc-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.logcard .lic{width:32px;height:32px;border-radius:9px;background:var(--bg3);border:1px solid var(--line);display:grid;place-items:center;color:var(--acc);flex:none}
.logcard .lic svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.logcard b{font-size:.88rem}
.logcard small{color:var(--mut);font-size:.78rem;line-height:1.45;flex:1}
/* Security cards: fixed size, never expand */
.logcard{min-height:238px}
.logcard b{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.logcard small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.logcard .lmanage[disabled]{opacity:.4;cursor:not-allowed}
.logcard .lmanage[disabled]:hover{color:var(--mut)}
/* Reusable security modal: same radius/style as cards */
.sm-h{display:flex;gap:10px;align-items:center;padding:16px 0 4px}
.sm-h .sic{width:34px;height:34px;flex:none;border-radius:9px;background:var(--bg3);border:1px solid var(--line);display:grid;place-items:center;color:var(--acc)}
.sm-h .sic svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.sm-h h2{padding:0;font-size:1rem;flex:1}
.sm-h .chipx{width:26px;height:26px;font-size:.9rem;flex:none}
.blink{all:unset;color:var(--acc);cursor:pointer;font-size:.82rem;padding:8px 4px}
.blink:hover{text-decoration:underline}
.movl{animation:fadeIn .2s ease}
.mobox{animation:popIn .22s cubic-bezier(.2,.9,.3,1.2)}
@keyframes fadeIn{from{opacity:0}}
@keyframes popIn{from{opacity:0;transform:scale(.96) translateY(8px)}}
@media(max-width:640px){.movl{place-items:end center;padding:0}.mobox{width:100%;border-radius:16px 16px 0 0;max-height:92vh}.logcard{min-height:0}}
.logcard .lmanage{all:unset;box-sizing:border-box;display:flex;align-items:center;gap:8px;border-top:1px solid var(--line);padding-top:12px;margin-top:4px;color:var(--mut);font-size:.82rem;cursor:pointer;min-height:36px}
.logcard .lmanage:hover{color:var(--tx)}
.logcard .lmanage svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.lm-color-wrap{display:flex;align-items:center;gap:10px}
.lm-color-wrap input[type=color]{width:40px;height:32px;padding:2px;border:1px solid var(--line);border-radius:8px;background:var(--bg);cursor:pointer}
.lm-color-wrap code{font:600 .85rem ui-monospace,Menlo,monospace;color:var(--tx)}
@media(max-width:1100px){.logcards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.logcards{grid-template-columns:1fr}}
/* Overview: Server Statistics cards + Server Analytics panels */
.sech{font-size:1rem;margin:20px 0 12px}
.sstats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:6px}
.sstat{border:1px solid var(--line);border-radius:14px;background:var(--bg2);padding:16px;display:flex;flex-direction:column;gap:6px;min-width:0}
.sstat:hover{border-color:var(--acc)}
.sstat .sic{width:32px;height:32px;border-radius:9px;background:var(--bg3);border:1px solid var(--line);display:grid;place-items:center;color:var(--acc)}
.sstat .sic svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.sstat em{font-style:normal;color:var(--mut);font-size:.78rem}
.sstat b{font-size:1.6rem;font-weight:700;font-variant-numeric:tabular-nums}
.sstat small{color:var(--mut);font-size:.75rem}
.ana-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;margin:20px 0 4px}
.ana-head h2{font-size:1rem}
.ana-head p{color:var(--mut);font-size:.82rem;margin-top:2px}
.ana-ctl{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.ana-ctl .in{width:auto;min-width:120px}
.anagrid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:10px 0 18px}
.apanel{border:1px solid var(--line);border-radius:12px;background:var(--bg2);padding:16px;min-width:0}
.apanel:hover{border-color:var(--acc)}
.apanel.wide{grid-column:1/-1}
.ap-h{display:flex;gap:10px;align-items:flex-start;margin-bottom:10px}
.ap-h .adot{width:28px;height:28px;flex:none;border-radius:8px;background:var(--bg3);border:1px solid var(--line);display:grid;place-items:center;color:var(--d,var(--acc))}
.ap-h .adot svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.ap-h b{display:block;font-size:.88rem}
.ap-h small{display:block;color:var(--mut);font-size:.76rem;margin-top:2px}
.ap-h .delta{display:block;color:var(--acc);font-size:.75rem;margin-top:4px}
.abars{display:flex;gap:5px;align-items:flex-end;height:110px;border:1px solid var(--line);border-radius:10px;padding:12px 12px 8px;background:var(--bg)}
.abar{flex:1;min-width:0;background:linear-gradient(var(--acc),transparent);opacity:.75;border-radius:4px 4px 0 0}
.agroup{flex:1;min-width:0;display:flex;gap:3px;align-items:flex-end;height:100%}
.agroup i{flex:1;border-radius:4px 4px 0 0;min-height:3px}
.agroup .aj{background:var(--acc);opacity:.85}
.agroup .al{background:var(--er,#e5a3a3);opacity:.8}
.ax{display:flex;gap:5px;margin-top:6px}
.ax span{flex:1;min-width:0;text-align:center;color:var(--mut);font-size:.68rem;white-space:nowrap;overflow:hidden}
.alegend{display:flex;gap:6px;align-items:center;color:var(--mut);font-size:.75rem;margin-top:8px}
.alegend i{width:10px;height:10px;border-radius:3px}
.alegend .dotj{background:var(--acc)}
.alegend .dotl{background:var(--er,#e5a3a3)}
.aempty{text-align:center;color:var(--mut);padding:26px 10px}
.aempty svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.5;opacity:.6}
.aempty b{display:block;margin-top:8px;font-size:.86rem;color:var(--tx)}
.aempty p{font-size:.76rem;margin-top:4px}
.prem{text-align:center;padding:24px 12px;display:grid;justify-items:center;gap:8px}
.prem .crown{width:34px;height:34px;color:#e5c07b}
.prem .crown svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.prem b{font-size:.86rem}
.prem p{color:var(--mut);font-size:.78rem;max-width:340px}
.arow{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.arow:last-child{border:0}
.arow .aav{width:30px;height:30px;flex:none;border-radius:50%;background:var(--bg3);border:1px solid var(--line);display:grid;place-items:center;font-size:.75rem;font-weight:700}
.arow .anm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.86rem}
.arow small{color:var(--mut);font-size:.75rem;white-space:nowrap}
.mblist{display:grid;gap:10px;padding:6px 0}
.mbrow{display:flex;gap:10px;align-items:center}
.mbrow .mbt{width:110px;flex:none;font-size:.82rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mbrow .mbb{flex:1;height:10px;border-radius:99px;background:var(--bg3);border:1px solid var(--line);overflow:hidden}
.mbrow .mbb i{display:block;height:100%;background:linear-gradient(90deg,var(--acc),transparent);border-radius:99px}
.mbrow b{width:56px;flex:none;text-align:end;font-size:.85rem;font-variant-numeric:tabular-nums}
@media(max-width:1100px){.sstats{grid-template-columns:repeat(3,1fr)}}
@media(max-width:860px){.anagrid{grid-template-columns:1fr}.sstats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.sstats{grid-template-columns:repeat(2,1fr)}.ana-head{flex-direction:column;align-items:stretch}.body{padding:20px 14px 90px}.top{gap:8px;padding:12px}.top .grow{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#kp{display:none}.sstat{padding:14px}.sstat b{font-size:1.3rem}.arow{flex-wrap:wrap}.arow small{white-space:normal}.mbrow .mbt{width:88px}.tkt th,.tkt td{padding:8px 4px;font-size:.8rem}.mobox{padding:6px 14px 16px}}
.vars{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.vars button{font:500 .75rem ui-monospace,Menlo,monospace;padding:3px 9px;border-radius:6px;background:var(--bg3);border:1px solid var(--line);color:var(--acc);cursor:pointer}
.wp{border:1px solid var(--line);border-radius:12px;padding:16px;background:var(--bg);display:flex;gap:12px;margin:14px 0 18px}
.wp>img{width:38px;height:38px;border-radius:50%;flex:none}.wp p{color:var(--mut);font-size:.88rem;white-space:pre-wrap;word-break:break-word}
.bar{position:fixed;left:250px;right:0;bottom:16px;display:flex;justify-content:center;pointer-events:none;padding:0 16px;transform:translateY(120%);transition:transform .25s}
.bar.o{transform:none}
.bar div{pointer-events:auto;display:flex;gap:12px;align-items:center;padding:10px 12px 10px 18px;border:1px solid var(--line);border-radius:12px;background:var(--bg2);box-shadow:0 12px 40px rgba(0,0,0,.35);font-size:.85rem}
.toast{position:fixed;top:16px;right:16px;padding:10px 16px;border-radius:10px;background:var(--bg2);border:1px solid var(--ok);color:var(--ok);font-size:.85rem;opacity:0;transform:translateY(-8px);transition:.25s;pointer-events:none;z-index:70}
.toast.o{opacity:1;transform:none}
.toast.err{border-color:var(--er,#e5a3a3);color:var(--er,#e5a3a3)}
.tkt{width:100%;border-collapse:collapse;font-size:.86rem;margin:6px 0 12px}
.tkt th,.tkt td{text-align:start;padding:10px 8px;border-bottom:1px solid var(--line)}
.tkt th{color:var(--mut);font-weight:500;font-size:.78rem}
.gh{font-size:.74rem;color:var(--mut);padding:14px 10px 4px;opacity:.85}
.movl{position:fixed;inset:0;z-index:80;display:grid;place-items:center;background:rgba(0,0,0,.55);padding:16px}
.movl[hidden]{display:none}
.mobox{width:min(560px,100%);max-height:88vh;overflow-y:auto;border:1px solid var(--line);border-radius:14px;background:var(--bg2);padding:6px 22px 18px}
.mobox>h2{padding:16px 0 4px}
.mobox textarea{width:100%;margin-top:8px;padding:9px 12px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--tx);font:inherit;font-size:.88rem;resize:vertical;min-height:56px}
.rlist{max-height:150px;overflow-y:auto;border:1px solid var(--line);border-radius:8px;padding:8px 12px;margin-top:8px;display:grid;gap:6px;background:var(--bg)}
.rlist label{display:flex;gap:8px;align-items:center;font-size:.85rem;cursor:pointer}
.dd{position:relative}
.dd-btn{width:100%;display:flex;justify-content:space-between;align-items:center;gap:8px;cursor:pointer;text-align:start}
.dd-n{color:var(--mut);font-size:.78rem;flex:none}
.dd-panel{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:90;border:1px solid var(--line);border-radius:10px;background:var(--bg);padding:10px;box-shadow:0 12px 40px rgba(0,0,0,.45)}
.dd-panel[hidden]{display:none}
.dd-search{width:100%;margin-bottom:8px}
.dd-list{max-height:160px;overflow-y:auto;display:grid;gap:6px}
.dd-list label{display:flex;gap:8px;align-items:center;font-size:.85rem;cursor:pointer}
.morow{display:flex;gap:10px;justify-content:flex-end;padding-top:14px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.chip{display:inline-flex;align-items:center;gap:8px;padding:4px 6px 4px 12px;border-radius:99px;background:var(--bg3);border:1px solid var(--line);font-size:.82rem}
.chipx{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;border:1px solid var(--line);background:var(--bg2);color:var(--mut);cursor:pointer;font-size:.75rem;line-height:1;padding:0;font-family:inherit}
.chipx:hover{border-color:var(--acc);color:var(--tx)}
#ceAliases{width:100%}
.chip-empty{color:var(--mut);font-size:.82rem}
/* Templates: browse/builder tabs, filters, cards, confirm */
.tabs{display:flex;gap:4px;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:4px;margin:0 0 14px}
.tabs button{all:unset;box-sizing:border-box;flex:1;text-align:center;padding:8px 10px;border-radius:7px;cursor:pointer;color:var(--mut);font-size:.85rem;min-height:38px}
.tabs button[aria-selected=true]{background:var(--bg3);color:var(--tx)}
.tpl-tools{display:grid;gap:10px;margin-bottom:6px}
.tpl-tools input[type=search]{width:100%;padding:10px 12px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--tx);font:inherit;font-size:.88rem}
.fchips{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.fchip{all:unset;box-sizing:border-box;padding:7px 14px;border:1px solid var(--line);border-radius:99px;font-size:.8rem;color:var(--mut);background:var(--bg2);cursor:pointer;min-height:36px}
.fchip[aria-pressed=true]{border-color:var(--acc);color:var(--tx)}
.fchip:hover{color:var(--tx)}
.tpl-tier{margin-left:auto;padding:8px 10px;border-radius:8px;border:1px solid var(--line);background:var(--bg2);color:var(--tx);font:inherit;font-size:.82rem;cursor:pointer}
.tpl-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}
@media(max-width:640px){.tpl-grid{grid-template-columns:1fr}}
.tpl{border:1px solid var(--line);border-radius:12px;background:var(--bg);padding:16px;display:flex;flex-direction:column;gap:6px}
.tpl:hover{border-color:var(--acc)}
.tpl b{font-size:.92rem}
.tpl small{color:var(--mut);font-size:.78rem}
.tpl-meta{color:var(--mut);font-size:.75rem}
.tpl-ft{margin-top:8px;padding-top:10px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}
.tpl-empty{border:1.5px dashed var(--line);border-radius:12px;padding:36px 20px;text-align:center;color:var(--mut);margin-top:12px}
.tpl-empty b{display:block;color:var(--tx);margin:10px 0 4px}
.warnbox{border:1px solid var(--line);border-radius:10px;background:var(--bg);padding:14px 16px;font-size:.85rem;color:var(--mut);margin:12px 0}
.warnbox b{color:var(--tx)}
.im{width:100%;margin-top:8px;display:grid;gap:10px}
.dz{border:1.5px dashed var(--line);border-radius:10px;padding:22px;text-align:center;color:var(--mut);font-size:.85rem;cursor:pointer;transition:border-color .15s,background .15s}
.dz:hover,.dz.on{border-color:var(--acc);background:var(--bg3);color:var(--tx)}
.th{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.th img{max-width:180px;max-height:110px;border-radius:8px;border:1px solid var(--line)}
.er{color:var(--er,#e5a3a3);font-size:.8rem}.er:empty{display:none}
.pl{display:block;color:var(--mut);margin:10px 0 4px}
.pimg{display:block;max-width:100%;max-height:220px;border-radius:8px;margin-top:8px}
.pi:empty{display:none}
select.in,.card select{cursor:pointer}
.cv{position:relative;container-type:inline-size;aspect-ratio:800/350;border-radius:10px;overflow:hidden;margin-top:10px;border:1px dashed var(--line);background:transparent;max-width:420px}
.cv.noimg{background:transparent;background-image:none}
.cv.noimg .cbg{display:none}
.cv[hidden]{display:none}
.cbg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.nm{position:absolute;transform:translate(-50%,-50%);padding:.15em .5em;font-weight:700;font-size:calc(var(--s,7)*1cqw);line-height:1.2;color:#fff;border:1.5px dashed var(--acc);border-radius:4px;cursor:move;white-space:nowrap;touch-action:none;user-select:none}
.nm:focus-visible{outline:2px solid #fff;outline-offset:3px}
.h{position:absolute;width:10px;height:10px;background:var(--acc);border:1.5px solid var(--color-primary-content,#0e1013);border-radius:2px;touch-action:none;opacity:0;pointer-events:none}
.h[data-h=nw]{left:-6px;top:-6px;cursor:nwse-resize}.h[data-h=ne]{right:-6px;top:-6px;cursor:nesw-resize}.h[data-h=sw]{left:-6px;bottom:-6px;cursor:nesw-resize}.h[data-h=se]{right:-6px;bottom:-6px;cursor:nwse-resize}
.pb{flex:1;min-width:0}.ce{color:var(--er,#e5a3a3);font-size:.8rem;display:block}.ce:empty{display:none}
.rl{align-self:flex-start}
.el[hidden]{display:none}
.am{position:absolute;transform:translate(-50%,-50%);width:calc(var(--s,20)*1cqw);aspect-ratio:1;border-radius:50%;border:1.5px dashed var(--acc);cursor:move;touch-action:none;user-select:none}
.am:focus-visible{outline:2px solid #fff;outline-offset:3px}
.ai{position:absolute;inset:0;border-radius:50%;overflow:hidden;background:linear-gradient(var(--ai-1,#3a4150),var(--ai-2,#1d2129));display:grid;place-items:center;pointer-events:none}
.ai svg{display:block}
.scrim{display:none}
@media(max-width:860px){.app{grid-template-columns:1fr}.side{position:fixed;inset:0 auto 0 0;width:270px;z-index:60;transform:translateX(-100%);transition:transform .25s;visibility:hidden}.side.o{transform:none;visibility:visible}.scrim.o{display:block;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:55}.menu{display:inline-flex}.bar{left:0}.stats{grid-template-columns:1fr}.row{flex-direction:column;align-items:stretch}.row .sw{align-self:flex-start}.in,.card select{width:100%}.usr span{display:none}}
@media(max-width:640px){.loggrid{grid-template-columns:1fr}.logsq{aspect-ratio:auto}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.rv{opacity:1;transform:none}}
</style>
<link rel="stylesheet" href="/css/brand-theme.css">
</head>
<body>
<div class="app">
<aside class="side" id="side" aria-label="Dashboard navigation">
<a class="brand" href="/dashboard"><img src="<%= VLOGO %>" alt="Vela logo" width="30" height="30">Vela</a>
<button class="srv" id="srvBtn" aria-label="Selected server"><b id="srvInitial">V</b><span id="srvName">Select a server</span></button>
<nav id="nav" style="display:flex;flex-direction:column;gap:2px"></nav>
<div class="grow"></div>
<a class="nv" href="#">Documentation</a><a class="nv" href="#">Support</a>
</aside>
<div class="scrim" id="sc"></div>
<div class="main">
<header class="top"><button class="btn menu" id="mn" aria-label="Open menu">Menu</button><button class="btn dsk" id="collapseBtn" aria-label="Toggle sidebar" aria-expanded="true" title="Toggle sidebar"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button><span class="grow" id="crumb">Vela</span><button class="btn" id="kp" aria-label="Search settings (Ctrl K)">Search ⌘K</button><div class="usr" id="usrChip"><i>U</i><span>Signed in with Discord</span></div><a class="btn" id="logoutBtn" href="/logout">Log out</a></header>
<div class="body" id="body"><div class="wrap" id="pg"></div></div>
</div></div>
<div class="bar" id="bar" aria-live="polite"><div><span>You have unsaved changes</span><button class="btn" id="rs">Reset</button><button class="btn p" id="sv">Save changes</button></div></div>
<div class="toast" id="tt" role="status" aria-live="polite">Changes saved</div>
<div class="pal" id="pal" role="dialog" aria-modal="true" aria-label="Search settings"><div class="pal-box"><input id="pin" type="search" placeholder="Type to search settings and commands… (Esc to close)" aria-label="Search settings and commands" autocomplete="off"><div class="pal-list" id="pl" role="listbox" aria-label="Results"></div></div></div>
<div class="movl" id="cmdModal" hidden><div class="mobox" role="dialog" aria-modal="true" aria-labelledby="cmdModalTitle">
<h2 id="cmdModalTitle">Edit command</h2>
<div class="row"><div><label for="ceCooldown">Cooldown (seconds)</label><small>Time before the command can be used again.</small></div><input class="in" id="ceCooldown" type="number" min="0" value="5"></div>
<div class="row stack"><div><label for="ceAliases">Aliases</label><small>Type an alias and press Enter to save — click × to remove.</small></div><div class="chips" id="ceChips"></div><input class="in" id="ceAliases" type="text" placeholder="Type an alias and press Enter"></div>
<div class="row stack" id="ceInvWrap" hidden><div><span class="lb" id="ceInvLabel">Inverse command aliases</span><small id="ceInvHint">The inverse command shares this editor — same way of adding.</small></div><div class="chips" id="ceInvChips"></div><input class="in" id="ceInvAliases" type="text" placeholder="Type an inverse alias and press Enter"></div>
<div class="row stack"><div><span class="lb">Allowed roles</span><small>Who can use it. Empty = everyone (admins always can).</small></div><div class="dd" id="ddAllowRole"><button type="button" class="in dd-btn" data-dd-btn><span>Select roles…</span><span class="dd-n">None selected</span></button><div class="dd-panel" hidden><input type="text" class="in dd-search" placeholder="Search roles…" aria-label="Search roles"><div class="dd-list"></div></div></div></div>
<div class="row stack"><div><span class="lb">Blocked roles</span><small>Who can never use it.</small></div><div class="dd" id="ddDenyRole"><button type="button" class="in dd-btn" data-dd-btn><span>Select roles…</span><span class="dd-n">None selected</span></button><div class="dd-panel" hidden><input type="text" class="in dd-search" placeholder="Search roles…" aria-label="Search roles"><div class="dd-list"></div></div></div></div>
<div class="row stack"><div><span class="lb">Allowed chats</span><small>Where it can be used. Empty = all channels.</small></div><div class="dd" id="ddAllowCh"><button type="button" class="in dd-btn" data-dd-btn><span>Select channels…</span><span class="dd-n">None selected</span></button><div class="dd-panel" hidden><input type="text" class="in dd-search" placeholder="Search channels…" aria-label="Search channels"><div class="dd-list"></div></div></div></div>
<div class="row stack"><div><span class="lb">Blocked chats</span><small>Where it can never be used.</small></div><div class="dd" id="ddDenyCh"><button type="button" class="in dd-btn" data-dd-btn><span>Select channels…</span><span class="dd-n">None selected</span></button><div class="dd-panel" hidden><input type="text" class="in dd-search" placeholder="Search channels…" aria-label="Search channels"><div class="dd-list"></div></div></div></div>
<div class="morow"><button class="btn" id="ceCancel" type="button">Cancel</button><button class="btn p" id="ceSave" type="button">Save</button></div>
</div></div>
<div class="movl" id="logModal" hidden><div class="mobox" role="dialog" aria-modal="true" aria-labelledby="lmTitle">
<h2 id="lmTitle">Log event</h2>
<p style="color:var(--mut);font-size:.82rem;margin:0 0 6px" id="lmSub"></p>
<div class="row"><div><label for="lmChannel">Channel</label><small>Where this log is sent.</small></div><select class="in" id="lmChannel"></select></div>
<div class="row"><div><span class="lb">Color</span><small>Embed accent color.</small></div><div class="lm-color-wrap"><input type="color" id="lmColor" value="#a9b9d8" aria-label="Log embed color"><code id="lmColorHex">#A9B9D8</code></div></div>
<div class="row stack"><div><span class="lb">Ping Roles</span><small>Roles mentioned with every log. Empty = no ping.</small></div><div class="dd" id="lmDdPing"><button type="button" class="in dd-btn" data-dd-btn><span>Select roles…</span><span class="dd-n">None selected</span></button><div class="dd-panel" hidden><input type="text" class="in dd-search" placeholder="Search roles…" aria-label="Search roles"><div class="dd-list"></div></div></div></div>
<div class="row stack"><div><span class="lb">Ignore Channels</span><small>Events from these channels are not logged.</small></div><div class="dd" id="lmDdIgCh"><button type="button" class="in dd-btn" data-dd-btn><span>Select channels…</span><span class="dd-n">None selected</span></button><div class="dd-panel" hidden><input type="text" class="in dd-search" placeholder="Search channels…" aria-label="Search channels"><div class="dd-list"></div></div></div></div>
<div class="row stack"><div><span class="lb">Ignore Roles</span><small>Events involving these roles are not logged.</small></div><div class="dd" id="lmDdIgRole"><button type="button" class="in dd-btn" data-dd-btn><span>Select roles…</span><span class="dd-n">None selected</span></button><div class="dd-panel" hidden><input type="text" class="in dd-search" placeholder="Search roles…" aria-label="Search roles"><div class="dd-list"></div></div></div></div>
<div class="morow"><button class="btn" id="lmCancel" type="button">Cancel</button><button class="btn p" id="lmSave" type="button">Save</button></div>
</div></div>
<div class="movl" id="secModal" hidden><div class="mobox" role="dialog" aria-modal="true" aria-labelledby="secModalTitle">
<div class="sm-h"><span class="sic" id="secModalIcon"></span><h2 id="secModalTitle">Option</h2><button class="chipx" id="secX" type="button" aria-label="Close">×</button></div>
<div id="secModalBody"></div>
<div class="morow"><button class="blink" id="secReset" type="button">Reset to default</button><span style="flex:1"></span><button class="btn" id="secCancel" type="button">Cancel</button><button class="btn p" id="secSave" type="button">Save</button></div>
</div></div>
<script>
const $=s=>document.querySelector(s),LOGO="<%= VLOGO %>";
const E=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const I={home:'<path d="M3 11l9-8 9 8M5 10v10h14V10"/>',hand:'<path d="M12 21s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 11c0 5.5-7 10-7 10z"/>',shield:'<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',tick:'<path d="M4 8h16v8H4zM9 8v8"/>',tag:'<path d="M20 12l-8 8-9-9V3h8z"/>',code:'<path d="M8 8l-5 4 5 4M16 8l5 4-5 4"/>',lock:'<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',gear:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/>',star:'<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',gift:'<path d="M3 9h18v4H3zM5 13v8h14v-8M12 9v12"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',bell:'<path d="M6 16v-5a6 6 0 0112 0v5l2 2H4zM10 21h4"/>',chat:'<path d="M4 5h16v11H9l-5 4z"/>',check:'<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',slash:'<path d="M8 20L16 4"/>',crown:'<path d="M3 8l4 4 5-7 5 7 4-4-2 11H5z"/>',users:'<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.5 3-5 6-5s6 1.5 6 5M17 6a3 3 0 010 6M21 20c0-2.500-1.500-4-3.500-4.600"/>',bolt:'<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',doc:'<path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/>',link:'<path d="M10 13a5 5 0 007.5.5l3-3a5 5 0 00-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 00-7.5-.5l-3 3a5 5 0 007 7l1.7-1.7"/>',ext:'<path d="M15 3h6v6M10 14L21 3M21 14v5a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h5"/>',at:'<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 006 0v-1a10 10 0 10-4 8"/>',aa:'<path d="M4 20L9 4M20 20L15 4M6.5 14h11"/>'};
