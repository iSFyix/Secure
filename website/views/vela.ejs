function cmdDesc(n){const all=CM.concat(SYS_SEC,SYS_BRL,SYS_SET_PUN,SYS_TKT,SYS_SET_SRV);return((all.find(c=>c[0]===n)||[n,n])[1])}
function ddFill(rootId,items,selected){const root=document.getElementById(rootId);if(!root)return;const list=root.querySelector(".dd-list");const have=new Set(items.map(o=>String(o.v)));const legacy=(selected||[]).filter(id=>!have.has(String(id))).map(id=>({v:String(id),label:"Deleted ("+id+")"}));list.innerHTML=items.concat(legacy).map(o=>`<label data-n="${E(o.label.toLowerCase())}"><input type="checkbox" value="${E(o.v)}"${(selected||[]).includes(String(o.v))?" checked":""}>${E(o.label)}</label>`).join("")||`<p class="empty">None found.</p>`;ddCount(root)}
function ddCount(root){const n=root.querySelectorAll("input:checked").length;const s=root.querySelector(".dd-n");if(s)s.textContent=n?n+" selected":"None selected"}
function openCmdEdit(n){ceCmd=n;const d=(CM.find(c=>c[0]===n)||[n,n])[1];$("#cmdModalTitle").textContent="/"+n+" — "+d;$("#ceCooldown").value=S["cooldown_"+n]??5;ceAliasesArr=ceParseAliases(S["aliases_"+n]);ceAliasesOrig=[...ceAliasesArr];$("#ceAliases").value="";ceRenderAliases();ceInvCmd=PAIRS[n]||null;const w=$("#ceInvWrap");if(ceInvCmd){$("#ceInvLabel").textContent="Inverse command: /"+ceInvCmd+" — "+cmdDesc(ceInvCmd);$("#ceInvHint").textContent="Leave it empty and /"+n+" does both actions itself (toggle). Add an alias to use a separate command — you decide.";ceInvAliasesArr=ceParseAliases(S["aliases_"+ceInvCmd]);ceInvAliasesOrig=[...ceInvAliasesArr];$("#ceInvAliases").value="";ceRenderInvAliases();w.hidden=false}else{ceInvAliasesArr=[];ceInvAliasesOrig=[];w.hidden=true}const roles=(window.__VELA_ROLES||[]).map(r=>({v:String(r.id),label:String(r.name)}));const chs=(window.__VELA_CHANNELS||[]).map(c=>({v:String(c.id),label:"#"+c.name}));ddFill("ddAllowRole",roles,S["allowroles_"+n]||[]);ddFill("ddDenyRole",roles,S["denyroles_"+n]||[]);ddFill("ddAllowCh",chs,S["allowchats_"+n]||[]);ddFill("ddDenyCh",chs,S["denychats_"+n]||[]);document.querySelectorAll("#cmdModal .dd-panel").forEach(p=>p.hidden=true);$("#cmdModal").hidden=false}
function closeCmdEdit(){ceCmd=null;ceInvCmd=null;document.querySelectorAll("#cmdModal .dd-panel").forEach(p=>p.hidden=true);$("#cmdModal").hidden=true}
pg.addEventListener("click",e=>{const b=e.target.closest("[data-cmd-edit]");if(b){window.__ceSecReturn=false;window.__ceSecRevert=null;openCmdEdit(b.dataset.cmdEdit)}});
document.addEventListener("click",e=>{const btn=e.target.closest("[data-dd-btn]");document.querySelectorAll(".dd-panel").forEach(p=>{if(!btn||p!==btn.closest(".dd").querySelector(".dd-panel"))p.hidden=true});if(btn){const p=btn.closest(".dd").querySelector(".dd-panel");p.hidden=!p.hidden;if(!p.hidden){const s=p.querySelector(".dd-search");if(s){s.value="";s.dispatchEvent(new Event("input",{bubbles:true}));const f=p.querySelector("input[type=checkbox]");if(f)f.focus()}}}});
