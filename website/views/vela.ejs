document.addEventListener("click",async e=>{
  if(cur!=="templates")return;
  const tab=e.target.closest("[data-ttab]");
  if(tab&&tab.closest('#pg')){tplTab=tab.dataset.ttab;const host=$("#pg");if(host&&cur==="templates")tplRender(host);return}
  const cat=e.target.closest("[data-tcat]");
  if(cat){tplCat=cat.dataset.tcat;const host=$("#pg");if(host&&cur==="templates")tplRender(host);return}
  if(e.target.closest("[data-tpl-clear]")){tplQ="";tplCat="All";tplTier="All";const host=$("#pg");if(host&&cur==="templates")tplRender(host);return}
  const ap=e.target.closest("[data-tpl-apply]");
  if(ap){tplApplyId=ap.dataset.tplApply;const m=$("#tplModal");if(m)m.hidden=false;return}
  if(e.target.closest("[data-tpl-back]")){tplApplyId=null;const m=$("#tplModal");if(m)m.hidden=true;return}
  if(e.target.closest("[data-tpl-confirm]")){
    const m=$("#tplModal");if(m)m.hidden=true;
    if(!tplApplyId)return;
    toast("Applying template…");
    try{
      const r=await window.__velaFetch("/api/templates/apply",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:tplApplyId})});
      const d=await r.json().catch(()=>({}));
      if(!r.ok||!d.success)throw new Error((d&&d.error)||"apply failed");
      toast(d.message||"Template applied.");tplApplyId=null;
      AUD.unshift({t:new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"}),c:["Applied template"]});chk();
    }catch(err){toast("Apply failed: "+(err.message||err),true)}
    return;
  }
  if(e.target.closest("[data-tpl-save]")){
    const inp=$("#tplName");const name=inp?inp.value.trim():"";
    if(!name){toast("Name your template first.",true);return}
    try{
      const r=await window.__velaFetch("/api/templates/save-current",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({name})});
      const d=await r.json().catch(()=>({}));
      if(!r.ok||!d.success)throw new Error((d&&d.error)||"save failed");
      toast(d.message||"Template saved.");tplLoad($("#pg"));
    }catch(err){toast("Save failed: "+(err.message||err),true)}
    return;
  }
  if(e.target.closest("[data-tpl-restore]")){
    if(!confirm("Restore the last backup snapshot? Missing roles and channels will be recreated."))return;
    try{
      const r=await window.__velaFetch("/api/templates/restore",{method:"POST"});
      const d=await r.json().catch(()=>({}));
      if(!r.ok||!d.success)throw new Error((d&&d.error)||"restore failed");
      toast(d.message||"Backup restored.");
    }catch(err){toast("Restore failed: "+(err.message||err),true)}
    return;
  }
  const del=e.target.closest("[data-tpl-del]");
  if(del){
    if(!confirm("Delete this custom template?"))return;
    try{
      const r=await window.__velaFetch("/api/templates/custom/"+encodeURIComponent(del.dataset.tplDel),{method:"DELETE"});
      const d=await r.json().catch(()=>({}));
      if(!r.ok||!d.success)throw new Error((d&&d.error)||"delete failed");
      toast("Template deleted.");tplLoad($("#pg"));
    }catch(err){toast("Delete failed: "+(err.message||err),true)}
    return;
  }
});
