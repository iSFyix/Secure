$("#ceInvChips").addEventListener("click",e=>{const b=e.target.closest("[data-chipx]");if(!b||!ceInvCmd)return;ceInvAliasesArr=ceInvAliasesArr.filter(a=>a!==b.dataset.chipx);ceRenderInvAliases();ceWriteInvAliases()});
